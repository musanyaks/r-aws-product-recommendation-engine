{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "ReadAppSecrets",
    "Effect": "Allow",
    "Action": "secretsmanager:GetSecretValue",
    "Resource": [
      "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:reco/db-password*",
      "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:reco/api-key*"
    ]
  }]
}