FROM rocker/r-ver:4.4.1

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl libcurl4-openssl-dev libssl-dev libsodium-dev libpq-dev \
      libicu-dev libxml2-dev zlib1g-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY renv.lock .Rprofile ./
COPY renv/ renv/

ENV RENV_CONFIG_INSTALL_PARALLEL=FALSE \
    RENV_CONFIG_CACHE_ENABLED=FALSE

RUN R -e "options(Ncpus = 1); renv::restore(exclude = 'ggplot2')"
RUN R -e "renv::restore(packages = 'ggplot2')"
RUN R -e "install.packages(c('bs4Dash','plotly','DT'), repos='https://packagemanager.posit.co/cran/__linux__/jammy/latest')"

RUN R -e "install.packages(c('bs4Dash','plotly','DT'), repos='https://packagemanager.posit.co/cran/__linux__/jammy/latest')"

COPY R/ R/
COPY dashboard/ dashboard/

EXPOSE 3838

CMD ["R", "-e", "shiny::runApp('dashboard', host='0.0.0.0', port=3838)"]